# Server port. The frontend uses http://localhost:5000 in local development.
PORT=5000

# MongoDB Atlas connection string (MONGO_URL is also accepted as the name)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/shopco?retryWrites=true&w=majority

# Long random text, used to sign login tokens
JWT_SECRET=use_a_long_random_secret_here
JWT_EXPIRES_IN=7d

# Website addresses allowed to call this API (comma separated, no spaces needed).
# On Vercel set this to your LIVE frontend address, e.g. https://shobxo.netlify.app
# (localhost is always allowed automatically when NODE_ENV is not "production")
CLIENT_URL=http://localhost:5173,https://shobxo.netlify.app

# Optional: fixes "querySrv ECONNREFUSED" errors with mongodb+srv:// links
MONGO_DNS_SERVERS=8.8.8.8,8.8.4.4
